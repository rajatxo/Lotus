<?xml version="1.0" encoding="utf-8"?>
<!--
  Lotus brand mark — an organic, soft-pentagon silhouette inspired by a closed lotus bud.
  Hand-drawn feel via cubic curves; meant to read both as a gem-cut and as a flower bud.
  All coordinates are in a 100x100 viewport; the path is centered and roughly 64dp wide.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Outer soft body of the bud — slightly asymmetric organic pentagon. -->
    <path
        android:name="bud_outer"
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M 50,8
            C 58,8 64,14 68,22
            C 72,30 80,34 86,40
            C 92,46 92,54 86,60
            C 80,66 72,70 68,78
            C 64,86 58,92 50,92
            C 42,92 36,86 32,78
            C 28,70 20,66 14,60
            C 8,54 8,46 14,40
            C 20,34 28,30 32,22
            C 36,14 42,8 50,8
            Z" />

    <!-- Inner highlight slit — suggests the bud's seam where petals will part. -->
    <path
        android:name="bud_seam"
        android:fillColor="#00000000"
        android:strokeColor="#66000000"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="
            M 50,22
            C 50,38 50,58 50,78" />
</vector>
